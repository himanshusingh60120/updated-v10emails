# Copy to .env.local and add your own credentials. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PAGESPEED_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: identify verification requests to your WAF/CDN. Use an agent your
# organization permits, and allowlist it only when you control the target site.
VERIFY_USER_AGENT=Mozilla/5.0 (compatible; AuditForgeBot/1.0; SEO audit verification)
VERIFY_RATE_LIMIT=600
