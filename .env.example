# ============================================================================
#  AuditForge environment variables
#  Every one is OPTIONAL — the app builds, deploys, and runs without any of
#  them. Each unset key disables exactly one feature and says so in the UI.
#  Local dev: copy this file to .env.local and fill in what you want.
#  Vercel: add these in Project → Settings → Environment Variables.
# ============================================================================

# --- AI analysis layer: fix instructions + executive summary -----------------
# Source: https://platform.openai.com/api-keys  (needs billing/credits)
# Unset  -> report still ships with all verified findings, minus AI sections
OPENAI_API_KEY=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
# Optional model override. Default: gpt-4o-mini (cheapest good option)
OPENAI_MODEL=gpt-4o-mini

# --- Module B: Core Web Vitals ----------------------------------------------
# Source: Google Cloud Console → APIs & Services → Credentials → Create API key
#         (enable "PageSpeed Insights API" in the API Library first). Free.
# Unset  -> Module B shows "skipped: PAGESPEED_API_KEY is not set"
PAGESPEED_API_KEY=AIzaSyC1T0jU1oVW1Ahq6cLTT4GpGI9nzcrgMwg

# --- Automatic Google Search Console connection -----------------------------
# Source: Google Cloud Console → APIs & Services → Credentials →
#         Create credentials → OAuth client ID → Web application.
#         Enable "Google Search Console API" in the API Library first.
#         Authorized redirect URIs must include BOTH:
#           https://<your-app>.vercel.app/api/gsc/callback
#           http://localhost:3000/api/gsc/callback
# Unset  -> "Connect Search Console" is disabled; the GSC CSV upload still works
GOOGLE_CLIENT_ID=907494376976-jgghk2vn9v1daejboa05ngoudgso3fon.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# Sharing needs no configuration: the report exports as one self-contained
