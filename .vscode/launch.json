{
  "version": "0.2.0",
  "configurations": [
    {
      // Debug the server side: /api/verify, the CPU meter, robots handling.
      "name": "Next.js: debug server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    {
      // Debug the queue driver: pause/resume, retries, checkpointing.
      "name": "Next.js: debug client (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Run: budget tests",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "scripts/budget.test.ts"],
      "console": "integratedTerminal"
    },
    {
      "name": "Run: queue resilience tests",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "scripts/queue-resilience.test.ts"],
      "console": "integratedTerminal"
    }
  ]
}
